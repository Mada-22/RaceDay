<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RaceDay</title>

    <link rel="stylesheet" href="~/css/site.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <header class="main-header">
        <nav class="navbar">

            <a class="brand" asp-controller="Home"
               asp-action="Index">
                <span class="brand-icon">R</span>
                <span>Race<span class="brand-highlight">Day</span></span>
            </a>

            <div class="nav-links">
                <a asp-controller="Home" asp-action="Index">
                    Home
                </a>

                <a href="#about">About</a>
                <a href="#events">Events</a>
                @if (User.Identity?.IsAuthenticated == true &&
                                User.IsInRole("Participant"))
                {
                    <a asp-controller="Entry"
                       asp-action="MyEntries"
                       class="nav-link">
                        My Registrations
                    </a>
                }
                @if (User.Identity?.IsAuthenticated == true &&
                                User.IsInRole("Participant"))
                {
                    <a asp-controller="Result"
                       asp-action="MyResults"
                       class="nav-link">
                        My Results
                    </a>
                }
            </div>

            <div class="nav-actions">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="nav-user">
                        Welcome, @User.Identity.Name
                    </span>

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post">

                        <button type="submit" class="btn-login">
                            Log out
                        </button>

                    </form>
                }
                else
                {
                    <a class="btn-login"
                       asp-controller="Account"
                       asp-action="Login">
                        Log in
                    </a>

                    <a class="btn-primary"
                       asp-controller="Account"
                       asp-action="Register">
                        Get Started
                    </a>
                }

            </div>
            

        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="main-footer">
        <div class="footer-content">
            <span class="footer-brand">RaceDay</span>

            <p>
                Bringing athletes, events and communities together.
            </p>

            <span class="copyright">
                &copy; @DateTime.Now.Year RaceDay. All rights reserved.
            </span>
        </div>
    </footer>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>