@model RaceDayMVC.Models.CreateEventViewModel

@{
    ViewData["Title"] = "Create Event";
}

<div class="event-form-page">
    <div class="event-form-card">

        <div class="auth-header">
            <span class="section-label">ORGANIZER PORTAL</span>
            <h1>Create an Event</h1>
            <p>Provide the details of the event you want to organise.</p>
        </div>

        <form asp-controller="Event"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>

            <div class="form-group">
                <label asp-for="EventName">Event Name</label>
                <input asp-for="EventName"
                       class="form-control"
                       placeholder="e.g. Cape Town City Run" />
                <span asp-validation-for="EventName"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"
                          placeholder="Describe your event..."></textarea>
                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Location">Location</label>
                <input asp-for="Location"
                       class="form-control"
                       placeholder="Event location" />
                <span asp-validation-for="Location"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Distance">Distance (km)</label>
                <input asp-for="Distance"
                       type="number"
                       step="0.01"
                       min="0.01"
                       max="1000"
                       class="form-control"
                       placeholder="e.g. 10" />
                <span asp-validation-for="Distance"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EventType">Event Type</label>
                <select asp-for="EventType" class="form-control">
                    <option value="">Select an event type</option>
                    <option value="Run">Run</option>
                    <option value="Walk">Walk</option>
                    <option value="Cycle">Cycle</option>
                </select>
                <span asp-validation-for="EventType"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EventDate">Event Date</label>
                <input asp-for="EventDate"
                       type="datetime-local"
                       class="form-control" />
                <span asp-validation-for="EventDate"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="OpenDate">Registration Opening Date</label>
                <input asp-for="OpenDate"
                       type="datetime-local"
                       class="form-control" />
                <span asp-validation-for="OpenDate"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ClosingDate">Registration Closing Date</label>
                <input asp-for="ClosingDate"
                       type="datetime-local"
                       class="form-control" />
                <span asp-validation-for="ClosingDate"
                      class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-primary">
                    Create Event
                </button>

                <a asp-controller="Organizer"
                   asp-action="Index"
                   class="btn-secondary">
                    Cancel
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}