@model List<RaceDayMVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Explore Events";
}

<div class="events-page">

    <section class="events-header">
        <div>
            <span class="dashboard-label">RACEDAY EVENTS</span>
            <h1>Find Your Next Challenge</h1>
            <p>Discover upcoming races, walks and cycling events.</p>
        </div>
    </section>

    <section class="events-list-section">

        <div class="events-list-heading">
            <div>
                <h2>Available Events</h2>
                <p>Explore events and find your next challenge.</p>
            </div>

            <span class="events-count">
                @Model.Count events
            </span>
        </div>

        @if (Model.Any())
        {
            <div class="events-grid">

                @foreach (var eventItem in Model.OrderBy(e => e.EventDate))
                {
                    <article class="event-card">

                        <div class="event-card-top">
                            <span class="event-type">
                                @eventItem.EventType
                            </span>

                            <span class="event-distance">
                                @eventItem.Distance km
                            </span>
                        </div>

                        <div class="event-card-body">

                            <div class="event-card-date">
                                @eventItem.EventDate.ToString("dd MMMM yyyy")
                            </div>

                            <h3>@eventItem.EventName</h3>

                            <p class="event-description">
                                @eventItem.Description
                            </p>

                            <div class="event-location">
                                <span>@eventItem.Location</span>
                            </div>

                            <div class="event-organization">
                                Organised by
                                <strong>@eventItem.OrganizationName</strong>
                            </div>

                        </div>

                        <div class="event-card-footer">

                            <a asp-controller="Event"
                               asp-action="Details"
                               asp-route-id="@eventItem.EventID"
                               class="btn-primary">
                                View Details
                            </a>

                        </div>

                    </article>
                }

            </div>
        }
        else
        {
            <div class="empty-state">
                <h3>No events available</h3>
                <p>There are currently no events to display.</p>
            </div>
        }

    </section>

</div>
